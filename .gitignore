# -----------------------------
# 2. Flutter 프로젝트 무시 대상 (Flutter)
# -----------------------------
/app/.dart_tool/
/.idea/
/app/*.iml
/app/.metadata
/app/.packages
/app/.flutter-plugins
/app/.flutter-plugins-dependencies
/build/
/app/.pub-cache/
/app/.pub/
/**/doc/api/
/**/ios/Flutter/.last_build_id

# Android 빌드 관련 (Flutter 내부)
/app/android/.gradle/
/app/android/app/build/
/app/android/local.properties
/app/android/app/debug/
/app/android/app/profile/
/app/android/app/release/

# iOS 빌드 관련 (Flutter 내부)
/app/ios/.symlinks/
/app/ios/Pods/
/app/ios/Runner.xcworkspace/
/app/ios/Runner.xcodeproj/project.xcworkspace/

#파이어베이스 관련
/app/android/app/google-services.json
/app/lib/firebase_options.dart

# riverpod 파일 관리
*.g.dart

# mock 데이터 제거
*.mocks.dart

# injectable 파일 제거
*.config.dart

# 테스트 측정 결과 제거
/app/coverage
/app/android/build/reports

# 민감 데이터 관리(Flutter 내부 민감 데이터)
*.env

# 키 암호 파일
cert.der

#기타
build_error.log
.flutter-plugins-dependencies
/.gemini/
/.claude/

firebase.json

# React web workspace
/web/node_modules/
/web/**/node_modules/
/web/dist/
/web/coverage/
/web/test-results/
